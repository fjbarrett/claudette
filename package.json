{
  "name": "claudette",
  "version": "1.0.0",
  "description": "Claudette is a terminal-first AI coding assistant backed by Ollama.",
  "type": "module",
  "bin": {
    "claudette": "./claudette.js"
  },
  "scripts": {
    "start": "node server.js",
    "cli": "node claudette.js",
    "dev": "node claudette.js",
    "bench": "node bench/run.js",
    "bench:leaderboard": "node bench/leaderboard.js --write",
    "bench:list": "node bench/run.js --list",
    "bench:all": "node bench/run.js --all --model gemma4:latest",
    "bench:gemma": "node bench/run.js --all --model gemma4:latest --verbose"
  }
}
