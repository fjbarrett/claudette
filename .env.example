# Claudette environment — copy to the trusted global config and add your keys.
#   mkdir -p ~/.config/claudette
#   cp .env.example ~/.config/claudette/.env
# A Claudette source checkout may also use its own gitignored `.env`. Claudette
# never loads `.env` from the project being edited. A real shell variable wins;
# CLAUDETTE_ENV_FILE may name another trusted file explicitly.
# You only need ONE provider key to start. Comments must be on their own line.

# ─── Hard model/usage policy (enabled by default) ────────────────────────────
# Only list/call routes verified as free, require native tool calling, and keep
# the local per-turn usage log enabled. Set an individual option to 0 to opt out.
CLAUDETTE_FREE_TIER_ONLY=1
CLAUDETTE_REQUIRE_TOOLS=1
CLAUDETTE_ALWAYS_TRACK=1
# A silent provider failure/rate limit rotates to another eligible free model.
# The selected fallback becomes the session model. Rotation never occurs after
# response text starts streaming, because replaying would duplicate output.
CLAUDETTE_MODEL_ROTATION=1
CLAUDETTE_MODEL_ROTATION_MAX=2
# Rotation preflights Groq against its Free-plan TPM ceiling. Raise only for an
# account with a higher limit; oversized requests skip Groq instead of causing 413.
GROQ_TPM_LIMIT=8000

# ─── Easiest start: one key, every major provider ────────────────────────────
# OpenRouter proxies OpenAI, Anthropic, Google, Meta Llama, Mistral, DeepSeek…
# Great when you can't run models locally. Then:
#   node claudette.js --model openrouter/free
OPENROUTER_API_KEY=

# ─── First-party providers ───────────────────────────────────────────────────
OPENAI_API_KEY=            # openai/gpt-4o
ANTHROPIC_API_KEY=         # anthropic/claude-opus-4-8
GEMINI_API_KEY=            # google/gemini-2.5-pro   (or set GOOGLE_API_KEY)
XAI_API_KEY=               # xai/grok-4
MISTRAL_API_KEY=           # mistral/mistral-large-latest
DEEPSEEK_API_KEY=          # direct API is billed (`DEEPSEEK_KEY` also accepted)
COHERE_API_KEY=            # cohere/command-a-03-2025
PERPLEXITY_API_KEY=        # perplexity/sonar-pro

# ─── Hosting platforms (no local GPU needed) ─────────────────────────────────
GROQ_API_KEY=              # groq/openai/gpt-oss-120b   (Free plan: 8K TPM / 200K TPD)
TOGETHER_API_KEY=          # together/meta-llama/Llama-3.3-70B-Instruct-Turbo
FIREWORKS_API_KEY=         # fireworks/accounts/fireworks/models/llama-v3p3-70b-instruct
HF_TOKEN=                  # HF router (`HF_KEY` accepted; only live zero-price tool routes are exposed)

# ─── Local (optional) ────────────────────────────────────────────────────────
# Ollama is used for bare model names (e.g. `qwen2.5-coder:14b`) or `ollama/…`.
# OLLAMA_BASE_URL=http://localhost:11434

# ─── Advanced: per-provider base-URL overrides (proxies / local OpenAI servers)
# Point the OpenAI provider at a local OpenAI-compatible server (LM Studio, vLLM,
# llama.cpp) — then use `openai/<model>`:
# OPENAI_BASE_URL=http://localhost:1234/v1
# Others: ANTHROPIC_BASE_URL, DEEPSEEK_BASE_URL, GROQ_BASE_URL, HF_BASE_URL,
# OPENROUTER_BASE_URL, TOGETHER_BASE_URL, FIREWORKS_BASE_URL, GEMINI_BASE_URL,
# XAI_BASE_URL, MISTRAL_BASE_URL, COHERE_BASE_URL, PERPLEXITY_BASE_URL

# ─── CLI behaviour ───────────────────────────────────────────────────────────
# macOS CLI sessions are confined to their launch directory by default, even
# with --yolo. Setting this to 0 removes the OS boundary; do not do that for an
# unattended or auto-approved session.
CLAUDETTE_WORKSPACE_SANDBOX=1
# Outbound model Bash networking remains loopback-only unless explicitly enabled
# with --network or this setting. This also permits LAN/metadata destinations;
# enable it only for trusted workspaces and prompts.
# CLAUDETTE_BASH_NETWORK=1
# Model Bash receives no credential-like inherited variables. Name only the
# exact exceptions a local build needs, comma-separated.
# CLAUDETTE_TOOL_ENV_ALLOW=DATABASE_URL
# fetch_url pins validated public DNS answers and rejects oversized/slow bodies.
# CLAUDETTE_FETCH_TIMEOUT=15000
# CLAUDETTE_FETCH_MAX_BYTES=1048576
# Reasoning effort for models that support it (low|medium|high|xhigh|max).
# Same as --effort / the /effort command. Leave unset for provider defaults.
# CLAUDETTE_EFFORT=high
# Pin a default model for the CLI and browser. Without an override, live models
# follow the benchmarked order led by installed Ollama Cloud Kimi and DeepSeek;
# missing tags are skipped and are never downloaded automatically.
# CLAUDETTE_MODEL=kimi-k2.7-code:cloud
# Groq Free has an 8K TPM bucket, so Claudette reserves at most 1K output tokens
# by default. Lower this for long prompts; raise it only when your quota allows.
# GROQ_MAX_TOKENS=1024
# Keep recent tool outputs inside Free TPM while retaining full local history.
# Set to 0 to disable on a higher-tier account.
# GROQ_TOOL_OUTPUT_CHARS=8000
# OpenRouter Free uses a slightly larger payload budget and the same 1K output
# discipline; set either to 0 only when you intentionally want no cap.
# OPENROUTER_MAX_TOKENS=1024
# OPENROUTER_TOOL_OUTPUT_CHARS=12000
# HF_MAX_TOKENS=1024
# Broad directory discovery shows generated trees without expanding them and
# caps the result. list_dir can explicitly opt into a generated tree when needed.
# CLAUDETTE_LIST_DIR_MAX_ENTRIES=200
# After a passing build/test, nudge after this many additional tools without an
# edit; two ignored nudges force one tools-disabled final summary. 0 disables.
# CLAUDETTE_POST_VERIFY_GUARD=6
# Auto-approve every tool call (no permission prompts). Same as -y / --yolo /
# the /yolo command. Any truthy value enables; 0/false/empty disables.
# CLAUDETTE_AUTO_APPROVE=1

# ─── Server / app ────────────────────────────────────────────────────────────
# PORT=4321
# HOST=127.0.0.1
# ANTHROPIC_MAX_TOKENS=4096
