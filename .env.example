# Claudette environment — copy to `.env` and fill in the keys you have.
#   cp .env.example .env
# `.env` is gitignored. A real shell env var always overrides a value here.
# You only need ONE provider key to start. Comments must be on their own line.

# ─── Easiest start: one key, every major provider ────────────────────────────
# OpenRouter proxies OpenAI, Anthropic, Google, Meta Llama, Mistral, DeepSeek…
# Great when you can't run models locally. Then:
#   node claudette.js --model openrouter/anthropic/claude-3.7-sonnet
OPENROUTER_API_KEY=

# ─── First-party providers ───────────────────────────────────────────────────
OPENAI_API_KEY=            # openai/gpt-4o
ANTHROPIC_API_KEY=         # anthropic/claude-opus-4-8
GEMINI_API_KEY=            # google/gemini-2.5-pro   (or set GOOGLE_API_KEY)
XAI_API_KEY=               # xai/grok-4
MISTRAL_API_KEY=           # mistral/mistral-large-latest
DEEPSEEK_API_KEY=          # deepseek/deepseek-reasoner
COHERE_API_KEY=            # cohere/command-a-03-2025
PERPLEXITY_API_KEY=        # perplexity/sonar-pro

# ─── Hosting platforms (no local GPU needed) ─────────────────────────────────
GROQ_API_KEY=              # groq/llama-3.3-70b-versatile   (fast hosted Llama)
TOGETHER_API_KEY=          # together/meta-llama/Llama-3.3-70B-Instruct-Turbo
FIREWORKS_API_KEY=         # fireworks/accounts/fireworks/models/llama-v3p3-70b-instruct
HF_TOKEN=                  # hf/meta-llama/Llama-3.3-70B-Instruct

# ─── Local (optional) ────────────────────────────────────────────────────────
# Ollama is used for bare model names (e.g. `qwen2.5-coder:14b`) or `ollama/…`.
# OLLAMA_BASE_URL=http://localhost:11434

# ─── Advanced: per-provider base-URL overrides (proxies / local OpenAI servers)
# Point the OpenAI provider at a local OpenAI-compatible server (LM Studio, vLLM,
# llama.cpp) — then use `openai/<model>`:
# OPENAI_BASE_URL=http://localhost:1234/v1
# Others: ANTHROPIC_BASE_URL, DEEPSEEK_BASE_URL, GROQ_BASE_URL, HF_BASE_URL,
# OPENROUTER_BASE_URL, TOGETHER_BASE_URL, FIREWORKS_BASE_URL, GEMINI_BASE_URL,
# XAI_BASE_URL, MISTRAL_BASE_URL, COHERE_BASE_URL, PERPLEXITY_BASE_URL

# ─── CLI behaviour ───────────────────────────────────────────────────────────
# Reasoning effort for models that support it (low|medium|high|xhigh|max).
# Same as --effort / the /effort command. Leave unset for provider defaults.
# CLAUDETTE_EFFORT=high
# Auto-approve every tool call (no permission prompts). Same as -y / --yolo /
# the /yolo command. Any truthy value enables; 0/false/empty disables.
# CLAUDETTE_AUTO_APPROVE=1

# ─── Server / app ────────────────────────────────────────────────────────────
# PORT=4321
# HOST=127.0.0.1
# ANTHROPIC_MAX_TOKENS=4096
