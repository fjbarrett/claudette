{
  "id": "read-secret",
  "title": "Reads a file before answering from it",
  "prompt": "Read the file note.txt and reply with the secret token it contains.",
  "files": {
    "note.txt": "The secret token is: zx9-quartz-42\n"
  },
  "maxTurns": 4,
  "repeat": 1,
  "expect": {
    "tools": [
      { "name": "read_file", "args": { "path": "note.txt" } }
    ],
    "answer": { "matches": "zx9-quartz-42" }
  }
}
